# Jira (optional - leave empty to disable sync)
JIRA_URL=
JIRA_TOKEN=
JIRA_EMAIL=
JIRA_SYNC_INTERVAL_MIN=10

# Server
DB_PATH=decodo.db
SERVER_PORT=8080

# OpenCode binary path
OPENCODE_BIN=opencode

# Projects are configured via the UI / API (POST /api/projects)
# Each project has its own repo_path, base_branch, stage_branch
